<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Support Center</title>
    <link rel="stylesheet" href="/css/support.css">
    <!-- <link rel="stylesheet" href="/css/my-tickets.css"> -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="logo">
            <img src="/images/logo_bgremove.png">
            <h2>EDUSHELF <span>Support Center</span></h2>
        </div>

        <div class="nav-links">
            <a href="/dashboard">Dashboard</a>
            <a href="/my-tickets">My Tickets</a>
        </div>
    </nav>

    <section class="hero">
        <div class="left">
            <h1>How can we help you?</h1>
            <p>
                Need help with your account, payment, subscription or found a bug?
                Tell us your issue and our team will get back to you soon.
            </p>

            <form action="/support" method="POST" enctype="multipart/form-data" id="supportForm">
                <label>Issue Category</label>

                <select id="category" name="category" required>
                    <option value="">Select Category</option>
                    <option>General</option>
                    <option>Account</option>
                    <option>Subscription</option>
                    <option>Resources</option>
                    <option>Technical</option>
                    <option>Payment</option>
                    <option>Bug Report</option>
                    <option>Feature Request</option>
                    <option>Other</option>
                </select>

                <label>Subject</label>
                <input type="text" id="subject" name="subject" placeholder="Enter issue title" required>

                <label>Describe your issue</label>
                <textarea id="message" name="message" placeholder="Explain your issue in detail..." required></textarea>

                <label for="attachments" class="upload-btn">
                    <i class="fa-solid fa-paperclip"></i>
                    Attach Screenshots (optional)
                </label>

                <input type="file" id="attachments" name="attachments" accept="image/*" multiple hidden>

                <div id="file-list"></div>
                <small style="color: #666; font-size: 0.82em; font-style: italic;">
                    Accepted: PNG, JPG, JPEG, Maximum 5 screenshots
                </small>

                <button type="submit">Submit Request</button>
            </form>
        </div>

        <div class="right">
            <img src="/images/support/doodle.png" class="doodle">
        </div>
    </section>

    <section class="quick-help">
        <div class="card" data-category="General">
            <i class="fa-regular fa-comments"></i>
            <h3>General</h3>
            <p>Questions about EduShelf.</p>
        </div>

        <div class="card" data-category="Account">
            <i class="fa-solid fa-user"></i>
            <h3>Account</h3>
            <p>Login, Profile & Account issues.</p>
        </div>

        <div class="card" data-category="Subscription">
            <i class="fa-solid fa-credit-card"></i>
            <h3>Subscription</h3>
            <p>Plans, renewals & payment issues.</p>
        </div>

        <div class="card" data-category="Technical">
            <i class="fa-solid fa-laptop-code"></i>
            <h3>Technical</h3>
            <p>Website bugs & errors.</p>
        </div>
    </section>

    <script src="/js/support.js"></script>

</body>
</html>