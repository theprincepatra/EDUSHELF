<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Landing</title>
    <link rel="stylesheet" href="css/landing.css">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
</head>

<body>
    <!-- PART 1 -->
    <div class="hero">
        <div class="bg-gradient gradient1"></div>
        <div class="bg-gradient gradient2"></div>
        <div class="bg-gradient gradient3"></div>

        <!-- NAVBAR -->
        <header>
            <div class="logo">
                <img src="/images/logo_bgremove.png" alt="EduShelf">
                <div>
                    <h2>EDUSHELF</h2>
                    <p>Academic Resource Platform</p>
                </div>
            </div>
            <nav>
                <a href="#platform">Platform</a>
                <a href="#about">About</a>
                <a href="#features">Features</a>
                <a href="#contact">Contact</a>
                <a href="/landing-login" class="nav-btn">Get Started</a>
            </nav>
        </header>

        <!-- PART 1 CONTAINER -->
        <div class="hero-container">
            <!-- left side -->
            <div class="hero-left">

                <div class="hero-badge">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <span>Built For Engineering Students</span>
                </div>

                <h1>One Platform.<br>Every Semester.<br>Every Resource.</h1>
                <p>Stop searching through WhatsApp groups and scattered Google Drive folders. Everything you need is organized beautifully inside EduShelf.</p>

                <div class="hero-buttons">
                    <a href="/landing-login" class="primary-btn">Explore Platform
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a href="/landing-signup" class="secondary-btn">Create Account</a>
                </div>

                <div class="hero-stats">
                    <div>
                        <h3>100+</h3>
                        <p>Resources</p>
                    </div>
                    <div>
                        <h3>All</h3>
                        <p>Branch</p>
                    </div>
                    <div>
                        <h3>8</h3>
                        <p>Semesters</p>
                    </div>
                </div>
            </div>

            <!-- dashboard preview -->
            <div class="hero-right">
                <div class="browser">

                    <div class="browser-top">
                        <div class="dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <p>dashboard.edushelf.in</p>
                    </div>
                    <div class="browser-body">
                        <img src="/images/dashboard-preview.png" alt="Dashboard">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PART 2 -->
    <section id="platform" class="platform">
        <div class="section-head">
            <p>PRODUCT SHOWCASE</p>
            <h2>Inside EduShelf</h2>
            <span>A quick preview of how students navigate through the platform.</span>
        </div>

        <div class="platform-wrapper">
            <div class="platform-left">
                <h2>Designed<br>For Faster<br>Learning.</h2>
                <p>From Branch selection to PDF reading, every screen has been crafted to reduce clutter and help students focus only on learning.</p>

                <div class="platform-tags">
                    <span><i class="fa-solid fa-book-open"></i>
                        Notes
                    </span>
                    <span><i class="fa-solid fa-file-lines"></i>
                        Assignments
                    </span>
                    <span><i class="fa-solid fa-book"></i>
                        Books
                    </span>
                    <span><i class="fa-solid fa-folder-open"></i>
                        PYQs
                    </span>
                    <span><i class="fa-solid fa-file-lines"></i>
                        Exam Essential
                    </span>
                    <span><i class="fa-solid fa-file-lines"></i>
                        Experiments
                    </span>
                    <span><i class="fa-solid fa-folder"></i>
                        Quiz
                    </span>
                    <span><i class="fa-solid fa-file-lines"></i>
                        Lab Reports
                    </span>
                    <span><i class="fa-solid fa-calendar"></i>
                        Lesson Plan
                    </span>
                </div>
            </div>

            <div class="platform-right">
                <div class="browser">
                    <div class="browser-top">
                        <div class="dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <p>edushelf.in</p>
                    </div>

                    <div class="browser-body">
                        <div class="slider">
                            <div class="slides">
                                <img class="active" src="/images/dashboard-preview.png" alt="Dashboard">
                                <img src="/images/semester.png" alt="Semester">
                                <img src="/images/subject.png" alt="Subject">
                                <img src="/images/resources.png" alt="Resources">
                                <img src="/images/resources-list.png" alt="Resources List">
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- About -->
    <section id="about" class="about">
        <div class="about-left">
            <span class="mini-title">WHY EDUSHELF</span>
            <h2>Built For<br>Students.</h2>
            <p>EduShelf brings notes, books, assignments, lesson plans, quizzes and previous year papers together into one organized platform, helping engineering students learn without distractions.</p>

            <div class="about-points">
                <div class="point">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Semester-wise Organization</span>
                </div>
                <div class="point">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Integrated PDF Reader</span>
                </div>
                <div class="point">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Fast Resource Navigation</span>
                </div>
                <div class="point">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Clean Learning Experience</span>
                </div>
                <div class="point">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Designed For Engineering Students</span>
                </div>
            </div>
        </div>

        <div class="about-right">
            <div class="about-preview">
                <img src="/images/person.png" alt="Dashboard">
            </div>
        </div>
    </section>

    <!-- Features -->
    <section id="features" class="features">
        <div class="section-head">
            <p>PRODUCT EXPERIENCE</p>
            <h2>Explore EduShelf</h2>
            <span>Everything changes automatically while you explore the platform.</span>
        </div>

        <div class="feature-showcase">
            <div class="feature-left">
                <div class="feature-text active">
                    <span>01</span>
                    <h2>Smart Dashboard</h2>
                    <p>A clean dashboard that keeps every academic resource just a few clicks away.</p>
                    <ul>
                        <li><i class="fa-solid fa-circle-check"></i>Modern Interface</li>
                        <li><i class="fa-solid fa-circle-check"></i>Fast Navigation</li>
                        <li><i class="fa-solid fa-circle-check"></i>Student Focused</li>
                    </ul>
                </div>

                <div class="feature-text">
                    <span>02</span>
                    <h2>Select Your Branch</h2>
                    <p>Browse different engineering branches through a clean and organized interface.</p>
                    <ul>
                        <li><i class="fa-solid fa-circle-check"></i>CSE</li>
                        <li><i class="fa-solid fa-circle-check"></i>AIML</li>
                        <li><i class="fa-solid fa-circle-check"></i>Cyber Security</li>
                    </ul>
                </div>

                <div class="feature-text">
                    <span>03</span>
                    <h2>Semester Navigation</h2>
                    <p>Access every semester instantly without searching through folders.</p>
                    <ul>
                        <li><i class="fa-solid fa-circle-check"></i>1st to 8th Semester</li>
                        <li><i class="fa-solid fa-circle-check"></i>Organized Layout</li>
                        <li><i class="fa-solid fa-circle-check"></i>Quick Access</li>
                    </ul>
                </div>

                <div class="feature-text">
                    <span>04</span>
                    <h2>Study Resources</h2>
                    <p>Books, Notes, Assignments, Lesson Plans and PYQs available together.</p>
                    <ul>
                        <li><i class="fa-solid fa-circle-check"></i>Notes</li>
                        <li><i class="fa-solid fa-circle-check"></i>Books</li>
                        <li><i class="fa-solid fa-circle-check"></i>Assignments</li>
                    </ul>
                </div>

                <div class="feature-text">
                    <span>05</span>
                    <h2>Integrated PDF Reader</h2>
                    <p>Read PDFs directly inside EduShelf without downloading them.</p>
                    <ul>
                        <li><i class="fa-solid fa-circle-check"></i>Fast Loading</li>
                        <li><i class="fa-solid fa-circle-check"></i>Minimal UI</li>
                        <li><i class="fa-solid fa-circle-check"></i>Distraction Free</li>
                    </ul>
                </div>
            </div>

            <div class="feature-right">
                <div class="browser feature-browser">
                    <div class="browser-top">
                        <div class="dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <p>edushelf.in</p>
                    </div>
                    <div class="browser-body">
                        <img class="feature-image active" src="/images/dashboard-preview.png">
                        <img class="feature-image" src="/images/semester.png">
                        <img class="feature-image" src="/images/subject.png">
                        <img class="feature-image" src="/images/resources.png">
                        <img class="feature-image" src="/images/resources-list.png">
                    </div>
                </div>

                <div class="slider-dots">
                    <span class="dot active"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="faq" id="faq">

        <div class="section-head">
            <p>QUESTIONS</p>
            <h2>Frequently Asked Questions</h2>
            <span>Everything you need to know before getting started.</span>
        </div>

        <div class="faq-container">

            <div class="faq-item active">

                <div class="faq-question">
                    <h3>Is EduShelf free to use?</h3>
                    <i class="fa-solid fa-plus"></i>
                </div>

                <div class="faq-answer">
                    <p>Yes. Students can access available academic resources without any subscription.</p>
                </div>

            </div>

            <div class="faq-item">

                <div class="faq-question">
                    <h3>Can I access resources from every semester?</h3>
                    <i class="fa-solid fa-plus"></i>
                </div>

                <div class="faq-answer">
                    <p>Resources are organized branch-wise and semester-wise for quick navigation.</p>
                </div>

            </div>

            <div class="faq-item">

                <div class="faq-question">
                    <h3>Do I need to download PDFs?</h3>
                    <i class="fa-solid fa-plus"></i>
                </div>

                <div class="faq-answer">
                    <p>No. PDFs can be viewed directly inside EduShelf using the integrated reader.</p>
                </div>

            </div>

            <div class="faq-item">

                <div class="faq-question">
                    <h3>Can new resources be added later?</h3>
                    <i class="fa-solid fa-plus"></i>
                </div>

                <div class="faq-answer">
                    <p>Yes. EduShelf is designed so resources can be expanded and updated continuously.</p>
                </div>

            </div>

        </div>

    </section>

    <!-- Footer -->
    <footer id="contact">
        <div class="footer-top">
            <div class="footer-about">
                <img src="/images/logo_bgremove.png" alt="EduShelf">
                <h2>EduShelf</h2>
                <p>A Digital Shelf designed to simplify learning by bringing every academic resource together in one organized platform.</p>

                <div class="socials">
                    <a href="https://www.github.com/theprincepatra"><i class="fa-brands fa-github"></i></a>
                    <a href="https://www.linkedin.com/in/theprincepatra/" target="_blank"><i class="fa-brands fa-linkedin-in"></i></a>
                    <a href="https://www.instagram.com/theprincepatra"><i class="fa-brands fa-instagram instagram"></i></a>
                </div>
            </div>

            <div class="footer-links">

                <h3>Platform</h3>

                <a href="#platform">Overview</a>

                <a href="#about">About</a>

                <a href="#features">Features</a>

                <a href="#faq">FAQ</a>

            </div>

            <div class="footer-links">

                <h3>Resources</h3>

                <a href="#">Notes</a>

                <a href="#">Books</a>

                <a href="#">Assignments</a>

                <a href="#">PYQs</a>

            </div>

            <div class="footer-links">

                <h3>Account</h3>

                <a href="/landing-login">Login</a>

                <a href="/landing-signup">Create Account</a>

                <a href="#">Privacy Policy</a>

                <a href="#">Terms & Conditions</a>

            </div>

        </div>

        <div class="footer-bottom">

            <p>© 2026 EduShelf. Designed & Developed by Prince Patra.</p>

            <a href="#" class="top-btn">
                <i class="fa-solid fa-arrow-up"></i>
            </a>

        </div>

    </footer>

    <script src="/js/landing.js"></script>
</body>
</html>