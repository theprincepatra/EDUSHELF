<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= ticket.ticketId %> | Admin</title>
    <link rel="stylesheet" href="/css/admin/a-dashboard.css">
    <link rel="stylesheet" href="/css/admin/a-ticket.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>
    <div class="sidebar-overlay"></div>

    <div class="admin-container">
        <%- include("partials/sidebar") %>
        <div class="main-content">
            <%- include("partials/navbar") %>
            <main class="content">
                <div class="ticket-page">
                    <div class="ticket-header">
                        <div>
                            <div class="flex1">
                                <h1><%= ticket.ticketId %></h1>
    
                                <div class="flex2">
                                    <span class="priority <%= ticket.priority.toLowerCase() %>">
                                        <%= ticket.priority %>
                                    </span>
                                    <span class="status <%= ticket.status.toLowerCase().replace(" ","-") %>">
                                        <%= ticket.status %>
                                    </span>
                                </div>
                            </div>

                            <div class="ticket-meta">
                                <span>Category: <%= ticket.category %></span>
                                <span>
                                    Created At:<%= new Date(ticket.createdAt).toLocaleDateString("en-IN") %>
                                </span>

                            </div>

                        </div>

                        <div class="back-btn">
                            <i class="fa-solid fa-arrow-left"></i>
                            <a href="/admin/a-support">Back to Support</a>
                        </div>

                    </div>

                    <div class="ticket-grid">

                        <div class="ticket-panel">

                            <section class="panel">

                                <h2>User Information</h2>

                                <div class="info-item">

                                    <label>Name</label>

                                    <p><%= ticket.user.name %></p>

                                </div>

                                <div class="info-item">

                                    <label>Username</label>

                                    <p>@<%= ticket.user.username %></p>

                                </div>

                                <div class="info-item">

                                    <label>Email</label>

                                    <p><%= ticket.user.email %></p>

                                </div>

                            </section>

                            <section class="panel">

                                <h2>Issue Description</h2>

                                <div class="issue-box">

                                    <%= ticket.message %>

                                </div>

                            </section>

                            <% if(ticket.attachments.length){ %>

                            <section class="panel">

                                <h2>Attachments</h2>

                                <div class="attachments">

                                    <% ticket.attachments.forEach(file=>{ %>

                                        <a href="<%= file %>" target="_blank">

                                            <img src="<%= file %>">

                                        </a>

                                    <% }) %>

                                </div>

                            </section>

                            <% } %>

                        </div>

                        <div class="ticket-panel">

                            <section class="panel">

                                <h2>Ticket Settings</h2>

                                <form action="/admin/support/<%= ticket._id %>/update" method="POST">

                                    <label>Status</label>

                                    <select name="status">

                                        <option value="Pending" <%= ticket.status==="Pending"?"selected":"" %>>Pending</option>

                                        <option value="In Progress" <%= ticket.status==="In Progress"?"selected":"" %>>In Progress</option>

                                        <option value="Resolved" <%= ticket.status==="Resolved"?"selected":"" %>>Resolved</option>

                                    </select>

                                    <label>Priority</label>

                                    <select name="priority">

                                        <option value="High" <%= ticket.priority==="High"?"selected":"" %>>High</option>

                                        <option value="Low" <%= ticket.priority==="Low"?"selected":"" %>>Low</option>

                                    </select>

                                    <button class="save-btn">

                                        <i class="fa-solid fa-floppy-disk"></i>

                                        Save Changes

                                    </button>

                                </form>

                            </section>

                            <section class="panel panel-grow">

                                <h2>Admin Response</h2>

                                <form action="/admin/support/<%= ticket._id %>/reply" method="POST">

                                    <textarea
                                        name="reply"
                                        placeholder="Write your response..."
                                    ><%= ticket.adminReply || "" %></textarea>

                                    <button class="reply-btn">

                                        <i class="fa-solid fa-paper-plane"></i>

                                        Send Response

                                    </button>

                                </form>

                            </section>

                        </div>

                    </div>

                </div>

            </main>

            <%- include("partials/footer") %>

        </div>

    </div>

</body>
</html>