<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduShelf Admin Dashboard</title>

    <link rel="stylesheet" href="/css/admin/a-dashboard.css">
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
</head>
<body>

    <div class="sidebar-overlay"></div>
    <div class="admin-container">
        <%- include("partials/sidebar") %>
        <div class="main-content">
            <%- include("partials/navbar") %>

            <section class="dashboard-content">

                <div class="page-title">

                    <div class="title-content">
                        <h1>Dashboard</h1>
                        <p>Welcome back, <strong><%= admin.name %></strong> 👋</p>
                    </div>

                </div>

                <div class="dashboard-wrapper">
                    <!-- ================= KPI ================= -->
                    <section class="dashboard-cards">
                        <div class="card users-card">

                            <div class="card-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>
                            <div class="card-info">
                                <span>Total Users</span>
                                <h2><%= totalUsers || 0 %></h2>
                            </div>
                        </div>

                        <div class="card subscription-card">
                            <div class="card-icon">
                                <i class="fa-solid fa-credit-card"></i>
                            </div>
                            <div class="card-info">
                                <span>Active Subscriptions</span>
                                <h2><%= activeSubscriptions || 0 %></h2>
                            </div>
                        </div>

                        <div class="card revenue-card">                    
                            <div class="card-icon">
                                <i class="fa-solid fa-indian-rupee-sign"></i>
                            </div>

                            <div class="card-info">
                                <span>Total Revenue</span>
                                <h2>₹<%= totalRevenue || 0 %></h2>
                            </div>
                        </div>

                        <div class="card resource-card">
                            <div class="card-icon">
                                <i class="fa-solid fa-book"></i>
                            </div>
                            <div class="card-info">
                                <span>Total Resources</span>
                                <h2><%= totalResources || 0 %></h2>
                            </div>
                        </div>

                        <div class="card support-card">
                            <div class="card-icon">
                                <i class="fa-solid fa-headset"></i>
                            </div>
                            <div class="card-info">
                                <span>Support Tickets</span>
                                <h2><%= supportTickets || 0 %></h2>
                            </div>
                        </div>
                    </section>

                    <!-- ================= REGISTRATION ANALYTICS ================= -->
                    <section class="analytics-section">
                        <div class="analytics-card">
                            <div class="analytics-header">
                                <div>
                                    <h2>User Registration Analytics</h2>
                                    <p>Track user registrations over time.</p>
                                </div>
                                <select>
                                    <option>Last 7 Days</option>
                                    <option selected>This Month</option>
                                    <option>This Year</option>
                                </select>
                            </div>

                            <div class="analytics-body">
                                <canvas id="registrationChart"></canvas>
                            </div>
                        </div>
                    </section>

                    <!-- ================= RECENT REGISTRATIONS ================= -->
                    <section class="dashboard-bottom">
                        <div class="dashboard-table-card">
                            <div class="table-header">
                                <div>
                                    <h2>Recent Registrations</h2>
                                    <p>Latest users who joined EduShelf</p>
                                </div>
                                <a href="/admin/users" class="view-all-btn">View All</a>
                            </div>

                            <div class="table-responsive">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Email</th>
                                            <th>Joined</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <% if (recentRegistrations && recentRegistrations.length) { %>
                                            <% recentRegistrations.forEach(user => { %>
                                                <tr>
                                                    <td>
                                                        <div class="user-cell">
                                                            <img src="<%= user.profilepicture || '/images/dashboard/default-profile.png' %>" alt="<%= user.name %>">
                                                            <div class="user-details">
                                                                <h4><%= user.name %></h4>
                                                                <span>@<%= user.username %></span>
                                                            </div>
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <%= user.email %>
                                                    </td>

                                                    <td>
                                                        <%= new Date(user.joinedon).toLocaleDateString("en-IN") %>
                                                    </td>

                                                    <td>
                                                        <span class="status free">Free</span>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="empty-state">
                                                    No users registered yet.
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                </div>
            </section>
            <%- include("partials/footer") %>
        </div>
    </div>

    <script src="/js/admin/sidebar.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const ctx = document.getElementById("registrationChart");
        if (ctx) {
            new Chart(ctx, {
                type: "line",
                data: {
                    labels: [],
                    datasets: [{label: "Registrations", data: [], tension: .4, fill: true }]
                },
                options: { responsive: true,maintainAspectRatio: false}
            });
        }
    </script>
</body>
</html>