<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduShelf Admin Dashboard</title>

    <link rel="stylesheet" href="/css/admin/a-dashboard.css">
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
</head>
<body>

    <div class="sidebar-overlay"></div>
    <div class="admin-container">
        <%- include("partials/sidebar") %>
        <div class="main-content">
            <%- include("partials/navbar") %>

            <section class="dashboard-content">

                <div class="page-title">

                    <div class="title-content">
                        <h1>Dashboard</h1>
                        <p>Welcome back, <strong><%= admin.name %></strong> 👋</p>
                    </div>

                </div>

                <div class="dashboard-wrapper">
                    <!-- ================= KPI ================= -->
                    <section class="dashboard-cards">
                        <a href="/admin/a-users">
                            <div class="card users-card">
                                <div class="card-icon">
                                    <i class="fa-solid fa-users"></i>
                                </div>
                                <div class="card-info">
                                    <span>Total Users</span>
                                    <h2><%= totalUsers || 0 %></h2>
                                </div>
                            </div>
                        </a>

                        <a href="#">
                            <div class="card subscription-card">
                                <div class="card-icon">
                                    <i class="fa-solid fa-credit-card"></i>
                                </div>
                                <div class="card-info">
                                    <span>Active Subscriptions</span>
                                    <h2><%= activeSubscriptions || 0 %></h2>
                                </div>
                            </div>
                        </a>

                        <a href="#">
                            <div class="card revenue-card">                    
                                <div class="card-icon">
                                    <i class="fa-solid fa-indian-rupee-sign"></i>
                                </div>

                                <div class="card-info">
                                    <span>Total Revenue</span>
                                    <h2>₹<%= totalRevenue || 0 %></h2>
                                </div>
                            </div>
                        </a>

                        <a href="#">
                            <div class="card resource-card">
                                <div class="card-icon">
                                    <i class="fa-solid fa-book"></i>
                                </div>
                                <div class="card-info">
                                    <span>Total Resources</span>
                                    <h2><%= totalResources || 0 %></h2>
                                </div>
                            </div>
                        </a>

                        <a href="/admin/a-support">
                            <div class="card support-card">
                                <div class="card-icon">
                                    <i class="fa-solid fa-headset"></i>
                                </div>
                                <div class="card-info">
                                    <span>Support Tickets</span>
                                    <h2><%= supportTickets || 0 %></h2>
                                </div>
                            </div>
                        </a>
                    </section>

                    <!-- ================= REGISTRATION ANALYTICS ================= -->
                    <section class="analytics-section">
                        <div class="analytics-card">
                            <div class="analytics-header">
                                <div>
                                    <h2>User Registration Analytics</h2>
                                    <p>Track user registrations over time.</p>
                                </div>

                                <select id="registrationRange">
                                    <option value="7days">Last 7 Days</option>
                                    <option value="month" selected>This Month</option>
                                    <option value="year">This Year</option>
                                </select>
                            </div>

                            <div class="analytics-body">
                                <canvas id="registrationChart"></canvas>
                            </div>
                        </div>
                    </section>

                    <!-- ================= RECENT REGISTRATIONS ================= -->
                    <section class="dashboard-bottom">
                        <div class="dashboard-table-card">
                            <div class="table-header">
                                <div>
                                    <h2>Recent Registrations</h2>
                                    <p>Latest users who joined EduShelf</p>
                                </div>
                                <a href="/admin/a-users" class="view-all-btn">View All</a>
                            </div>

                            <div class="table-responsive">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Email</th>
                                            <th>Joined</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <% if (recentRegistrations && recentRegistrations.length) { %>
                                            <% recentRegistrations.forEach(user => { %>
                                                <tr>
                                                    <td>
                                                        <div class="user-cell">
                                                            <img src="<%= user.profilepicture || '/images/dashboard/default-profile.png' %>" alt="<%= user.name %>">
                                                            <div class="user-details">
                                                                <h4><%= user.name %></h4>
                                                                <span>@<%= user.username %></span>
                                                            </div>
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <%= user.email %>
                                                    </td>

                                                    <td>
                                                        <%= new Date(user.joinedon).toLocaleDateString("en-IN") %>
                                                    </td>

                                                    <td>
                                                        <span class="status free">Free</span>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="empty-state">
                                                    No users registered yet.
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                </div>
            </section>
            <%- include("partials/footer") %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const chartCanvas = document.getElementById("registrationChart");
        const rangeSelect = document.getElementById("registrationRange");
        let registrationChart;

        async function loadRegistrationChart(range = "month") {
            try {
                const response = await fetch(`/admin/a-dashboard/registration-data?range=${range}`);

                if (!response.ok) {
                    throw new Error("Failed to fetch registration data");
                }

                const data = await response.json();
                let labels = [];
                let values = [];

                if (range === "7days") {
                    const today = new Date();
                    for (let i = 6; i >= 0; i--) {
                        const date = new Date(today);
                        date.setDate(today.getDate() - i);
                        const year = date.getFullYear();
                        const month = String(date.getMonth() + 1).padStart(2, "0");
                        const day = String(date.getDate()).padStart(2, "0");

                        const key = `${year}-${month}-${day}`;
                        labels.push(
                            date.toLocaleDateString("en-IN", {day: "numeric", month: "short" })
                        );

                        const found = data.find(item => item._id === key);
                        values.push(found ? found.count : 0);
                    }
                }else if (range === "month") {
                    const today = new Date();
                    const year = today.getFullYear();
                    const month = today.getMonth();

                    const daysInMonth = new Date(year, month + 1, 0 ).getDate();
                    for (let day = 1; day <= daysInMonth; day++) {
                        const key = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
                        labels.push(day.toString());
                        const found = data.find(item => item._id === key);
                        values.push(found ? found.count : 0);
                    }
                }else if (range === "year") {
                    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    const year = new Date().getFullYear();

                    for (let month = 1; month <= 12; month++) {
                        const key = `${year}-${String(month).padStart(2, "0")}`;
                        labels.push(months[month - 1]);
                        const found = data.find(item => item._id === key);
                        values.push(found ? found.count : 0);
                    }
                }

                if (registrationChart) {
                    registrationChart.destroy();
                }
                registrationChart = new Chart(chartCanvas, {
                    type: "line",
                    data: {
                        labels: labels,
                        datasets: [{label: "Registrations", data: values, borderWidth: 2, tension: 0.4, fill: true }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {intersect: false, mode: "index" },
                        plugins: { legend:{ display: true }},
                        scales: {
                            y: {beginAtZero: true, ticks: {precision: 0}},
                            x: {ticks: { autoSkip: true, maxTicksLimit: 12 }}
                        }
                    }
                });
            } catch (error) {
                console.error("Chart error:", error);
            }
        }
        rangeSelect.addEventListener("change", function () {
            loadRegistrationChart(this.value);
        });
        loadRegistrationChart("month");
    </script>

    <script src="/js/admin/sidebar.js"></script>


</body>
</html>