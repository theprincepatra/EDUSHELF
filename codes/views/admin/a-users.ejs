<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users | EduShelf Admin</title>
    <link rel="stylesheet" href="/css/admin/a-dashboard.css">
    <link rel="stylesheet" href="/css/admin/a-users.css">
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
</head>

<body>

    <div class="sidebar-overlay"></div>

    <div class="admin-container">

        <%- include("partials/sidebar") %>

        <div class="main-content">

            <%- include("partials/navbar") %>

            <section class="users-page">

                <div class="page-header">
                    <div>
                        <h1>Users</h1>
                        <p>
                            Manage <strong><%= totalUsers || users.length %></strong> registered users
                        </p>
                    </div>
                </div>

                <!-- Statistics -->
                <div class="users-stats">

                    <div class="stat-card">
                        <div class="stat-icon total">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div>
                            <h2><%= totalUsers || 0 %></h2>
                            <p>Total Users</p>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon premium">
                            <i class="fa-solid fa-crown"></i>
                        </div>
                        <div>
                            <h2><%= premiumUsers || 0 %></h2>
                            <p>Premium Users</p>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon verified">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div>
                            <h2><%= verifiedUsers || 0 %></h2>
                            <p>Verified Users</p>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon suspended">
                            <i class="fa-solid fa-user-slash"></i>
                        </div>
                        <div>
                            <h2><%= suspendedUsers || 0 %></h2>
                            <p>Suspended Users</p>
                        </div>
                    </div>

                </div>

                <!-- Toolbar -->
                <form action="/admin/a-users" method="GET" class="toolbar">

                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" name="search" placeholder="Search users..." >
                    </div>

                    <div class="filters">
                        <button type="button" class="active">All</button>
                        <button type="button">Premium</button>
                        <button type="button">Free</button> 
                    </div>

                    <div class="date-filter">
                        <i class="fa-regular fa-calendar"></i>

                        <select id="filterType" name="filterType">
                            <option value="Normal" <%= filterType === "Normal" ? "selected" : "" %>>
                                Normal
                            </option>
                            <option value="date" <%= filterType === "date" ? "selected" : "" %>>
                                Specific Date
                            </option>
                            <option value="month" <%= filterType === "month" ? "selected" : "" %>>
                                Specific Month
                            </option>
                        </select>


                        <% if (filterType === "date") { %>
                            <input type="date" id="dateInput" name="date" value="<%= date || '' %>" >
                        <% } %>

                        <% if (filterType === "month") { %>
                            <input type="month" id="monthInput" name="month" value="<%= month || '' %>">
                        <% } %>
                    </div>
                </form>

                <!-- Bulk Actions -->
                <div class="users-actions">
                    <div class="left-actions">
                        <button class="bulk-btn delete" id="deleteSelected">
                            <i class="fa-solid fa-trash"></i>
                            Delete
                        </button>
                        <button class="bulk-btn suspend" id="suspendSelected">
                            <i class="fa-solid fa-user-slash"></i>
                            Suspend
                        </button>
                    </div>

                    <div class="right-actions">
                        <span>Total Selected : <strong>0</strong> </span>
                    </div>

                </div>

                <!-- Users Table -->
                <div class="users-table-card">
                    <table>
                        <thead>
                            <tr>
                                <th class="checkbox-column">
                                    <input type="checkbox" id="selectAll">
                                </th>
                                <th>User</th>
                                <th>Email</th>
                                <th>Plan</th>
                                <th>Status</th>
                                <th>Joined</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (users.length > 0) { %>
                                <% users.forEach(user => { %>
                                    <tr>
                                        <td class="checkbox-column">
                                            <input type="checkbox" class="user-checkbox" value="<%= user._id %>">
                                        </td>

                                        <td>
                                            <div class="user-cell">
                                                <img src="<%= user.profilepicture %>" alt="Profile" >
                                                <div>
                                                    <h4>
                                                        <%= user.name %>
                                                        <% if (user.verified) { %>
                                                            <i class="fa-solid fa-circle-check verified-icon"></i>
                                                        <% } %>
                                                    </h4>
                                                    <span>@<%= user.username %></span>
                                                </div>
                                            </div>
                                        </td>

                                        <td><%= user.email %></td>

                                        <td>
                                            <% if (user.premium) { %>
                                                <span class="badge premium">Premium</span>
                                            <% } else { %>
                                                <span class="badge free">Free</span>
                                            <% } %>
                                        </td>

                                        <td>
                                            <% if (user.active) { %>
                                                <span class="badge verified">Active</span>
                                            <% } else { %>
                                                <span class="badge suspended">Suspended</span>
                                            <% } %>
                                        </td>

                                        <td>
                                            <%= new Date(user.joinedon).toLocaleDateString("en-IN") %>
                                        </td>

                                        <td>
                                            <div class="actions">
                                                <button class="edit-btn">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button class="delete-btn">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="no-users">
                                        <i class="fa-solid fa-users-slash"></i>
                                        <p>No users found for this month.</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>

                    <!-- Table Footer -->
                    <div class="table-footer">
                        <div class="entries-info">
                            Showing
                            <strong>
                                <%= users.length > 0 ? 1 : 0 %>
                            </strong>
                            to
                            <strong>
                                <%= users.length %>
                            </strong>
                            of
                            <strong>
                                <%= users.length %>
                            </strong>

                            users

                        </div>

                        <div class="pagination">

                            <button class="page-btn">
                                <i class="fa-solid fa-angle-left"></i>
                            </button>

                            <button class="page-btn active">
                                1
                            </button>

                            <button class="page-btn">
                                2
                            </button>

                            <button class="page-btn">
                                3
                            </button>

                            <span>...</span>

                            <button class="page-btn">
                                18
                            </button>

                            <button class="page-btn">
                                <i class="fa-solid fa-angle-right"></i>
                            </button>

                        </div>

                    </div>

                </div>

            </section>

            <%- include("partials/footer") %>

        </div>

    </div>

    <script>
        const filterType = document.getElementById("filterType");

        filterType.addEventListener("change", function () {
            const type = this.value;

            if (type === "Normal") {
                window.location.href = "/admin/a-users";
                return;
            }

            const currentUrl = new URL(window.location.href);

            currentUrl.searchParams.set("filterType", type);
            currentUrl.searchParams.delete("date");
            currentUrl.searchParams.delete("month");

            window.history.pushState({}, "", currentUrl);

            location.reload();
        });

        const dateInput = document.getElementById("dateInput");

        if (dateInput) {
            dateInput.addEventListener("change", function () {
                if (!this.value) return;

                const currentUrl = new URL(window.location.href);

                currentUrl.searchParams.set("filterType", "date");
                currentUrl.searchParams.set("date", this.value);
                currentUrl.searchParams.delete("month");

                window.history.pushState({}, "", currentUrl);

                location.reload();
            });
        }

        const monthInput = document.getElementById("monthInput");

        if (monthInput) {
            monthInput.addEventListener("change", function () {
                if (!this.value) return;

                const currentUrl = new URL(window.location.href);

                currentUrl.searchParams.set("filterType", "month");
                currentUrl.searchParams.set("month", this.value);
                currentUrl.searchParams.delete("date");

                window.history.pushState({}, "", currentUrl);

                location.reload();
            });
        }
    </script>

    <script src="/js/admin/sidebar.js"></script>

    <script>
        const selectAll = document.getElementById("selectAll");
        const userCheckboxes = document.querySelectorAll(".user-checkbox");
        const selectedCount = document.querySelector(".right-actions strong");

        function updateSelectedCount() {
            const selected = document.querySelectorAll(".user-checkbox:checked");
            selectedCount.textContent = selected.length;
        }

        selectAll.addEventListener("change", function () {
            userCheckboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });

            updateSelectedCount();
        });

        userCheckboxes.forEach(checkbox => {
            checkbox.addEventListener("change", function () {
                const allChecked =
                    document.querySelectorAll(".user-checkbox:checked").length ===
                    userCheckboxes.length;

                selectAll.checked = allChecked;

                updateSelectedCount();
            });
        });
    </script>

</body>
</html>